# Secrets — filled in locally, never committed
.env

# Python
.venv/
__pycache__/
*.pyc

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/

# Volatile data caches (fixtured copies of captured documents live under
# src/uwazi_rag/tests/fixtures/ and are committed; everything in data/ is
# disposable and rebuildable from Uwazi alone — PLAN.md golden rule 4),
# except the eval harness artifacts which are versioned in git.
data/raw/
# Step 3 naive index — disposable, rebuildable from data/raw captures.
data/naive_store.json
data/*.tmp
# Step 3.5 benchmark stores — one JSON per readable content-derived name
# (<chunk-method-slug>__<model-slug>-<corpus-digest8>.json — e.g.
# merge-1800-0.15-on__bge-m3-0ac7665e.json; same deal as the naive index:
# disposable, rebuildable, never committed). Sweep caching is invisible —
# use_cases/run_sweep.py owns the paths; pre-existing stores such as the
# baseline data/naive_store.json are always read-only.
data/benchmark_stores/
# Step 3.5 — the sampled passage groups behind golden.jsonl are derived/disposable
# (re-generable with `uwazi-rag build-golden`); golden.jsonl, manual.jsonl and
# about.md are the committed half.
data/eval/passages.jsonl
data/eval/*.tmp
