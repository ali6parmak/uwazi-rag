# Local Uwazi instance (admin credentials — PDF segmentation needs admin)
UWAZI_URL="http://localhost:3000"
UWAZI_USER="admin"
UWAZI_PASSWORD="change this password now"

# Ollama (embeddings + chat)
OLLAMA_BASE_URL="http://localhost:11434"
EMBEDDING_MODEL="bge-m3"
# Vector size is a property of the model (bge-m3: 1024); probed at runtime.
EMBEDDING_DIMENSIONS=1024

# REST service port (Step 8) — siblings use 5051/5054/5055/5056/7050, avoid collisions
SERVICE_PORT=5057
